# ==========================================
# 存储配置
# ==========================================
# 存储模式选择: local | r2 | github
STORAGE_MODE=local

# ==========================================
# 本地存储配置 (STORAGE_MODE=local)
# ==========================================
# 图片源目录（相对于项目根目录）
LOCAL_BASE_PATH=./public/photos
# 访问URL前缀
LOCAL_PUBLIC_PATH=/photos/

# ==========================================
# Cloudflare R2 存储配置 (STORAGE_MODE=r2)
# ==========================================
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# 自定义域名（可选，用于公共访问）
R2_PUBLIC_URL=https://your-custom-domain.com
# 忽略的目录名称（逗号分隔，构建时跳过这些目录）
# 默认已忽略 .thumbnails（脚本生成的缩略图目录）
R2_IGNORE_DIRS=.thumbnails

# ==========================================
# GitHub 存储配置 (STORAGE_MODE=github)
# ==========================================
GITHUB_OWNER=your-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main
# 仓库中的图片目录（如 images）
GITHUB_PATH=
# GitHub Personal Access Token（可选，用于私有仓库）
GITHUB_TOKEN=
