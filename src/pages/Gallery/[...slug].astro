---
import BaseHead from '../../components/BaseHead.astro';
import { readFile } from 'fs/promises';
import { join } from 'path';

export async function getStaticPaths() {
  const photosPath = join(process.cwd(), 'public', 'photos.json');
  try {
    const data = await readFile(photosPath, 'utf-8');
    const photos = JSON.parse(data);
    
    return photos.map((photo, index) => ({
      params: { slug: photo.key },
      props: { 
        photo,
        allPhotos: photos,
        currentIndex: index,
        prevPhoto: index > 0 ? photos[index - 1] : null,
        nextPhoto: index < photos.length - 1 ? photos[index + 1] : null,
      },
    }));
  } catch (e) {
    console.error("Error loading photos.json", e);
    return [];
  }
}

const { photo, allPhotos, currentIndex, prevPhoto, nextPhoto } = Astro.props as { 
  photo: any;
  allPhotos: any[];
  currentIndex: number;
  prevPhoto: any;
  nextPhoto: any;
};
const { exif, filename, width, height, size, format, lastModified, tags, thumbnails, Original, id } = photo || {};

// Helper to format bytes
function formatBytes(bytes, decimals = 2) {
  if (!+bytes) return '0 Bytes';
  const k = 1024;
  const dm = decimals < 0 ? 0 : decimals;
  const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))} ${sizes[i]}`;
}

// Helper to format date
function formatDate(dateString) {
  try {
    return new Date(dateString).toLocaleString('zh-CN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    });
  } catch (e) {
    return dateString;
  }
}
---

<!doctype html>
<html lang="zh-cn">
	<head>
		<BaseHead title={filename} description={`Photo: ${filename}`} />
        <style>
            * {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                padding: 0;
                height: 100vh;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                background: #1a1a1a;
            }
            .photo-container {
                flex: 1;
                display: flex;
                overflow: hidden;
                background: #1a1a1a;
                min-height: 0;
                height: 100%;
            }
            .photo-main-wrapper {
                flex: 1;
                display: flex;
                flex-direction: column;
                background: #1a1a1a;
                position: relative;
                min-height: 0;
                min-width: 0;
                overflow: hidden;
            }
            .photo-main {
                flex: 1;
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative;
                overflow: hidden;
                min-height: 0;
            }
            .image-container {
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                height: 100%;
                touch-action: none;
                cursor: grab;
                overflow: hidden;
            }
            .image-container.dragging {
                cursor: grabbing;
            }
            .image-container img {
                max-width: 100%;
                max-height: 100%;
                object-fit: contain;
                box-shadow: 0 0 20px rgba(0,0,0,0.5);
                transition: transform 0.1s ease-out;
                transform-origin: center center;
                user-select: none;
                -webkit-user-drag: none;
            }
            .photo-sidebar {
                width: 360px;
                background: #fff;
                border-left: 1px solid #eee;
                overflow-y: auto;
                padding: 24px;
                flex-shrink: 0;
                display: flex;
                flex-direction: column;
                gap: 24px;
            }
            .info-section h3 {
                font-size: 12px;
                font-weight: 700;
                color: #888;
                margin: 0 0 12px 0;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                border-bottom: 1px solid #eee;
                padding-bottom: 8px;
            }
            .info-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 16px;
            }
            .info-item {
                display: flex;
                flex-direction: column;
            }
            .info-label {
                font-size: 12px;
                color: #999;
                margin-bottom: 4px;
            }
            .info-value {
                font-size: 14px;
                color: #333;
                font-weight: 500;
                word-break: break-word;
            }
            .tag-cloud {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
            }
            .tag {
                background: #f0f0f0;
                padding: 4px 10px;
                border-radius: 12px;
                font-size: 12px;
                color: #555;
                transition: background 0.2s;
            }
            .tag:hover {
                background: #e0e0e0;
            }
            
            /* 顶部工具栏 */
            .toolbar {
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 16px 20px;
                z-index: 20;
                background: linear-gradient(to bottom, rgba(0,0,0,0.5), transparent);
            }
            .toolbar-left, .toolbar-right {
                display: flex;
                gap: 8px;
                align-items: center;
            }
            .toolbar-btn {
                background: rgba(255,255,255,0.1);
                color: white;
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                backdrop-filter: blur(10px);
                transition: background 0.2s;
                border: 1px solid rgba(255,255,255,0.2);
                cursor: pointer;
            }
            .toolbar-btn:hover {
                background: rgba(255,255,255,0.2);
            }
            .zoom-indicator {
                color: white;
                font-size: 12px;
                background: rgba(0,0,0,0.5);
                padding: 4px 12px;
                border-radius: 12px;
                backdrop-filter: blur(10px);
            }
            
            /* 导航按钮 */
            .nav-btn {
                position: absolute;
                top: 50%;
                transform: translateY(-50%);
                z-index: 15;
                background: rgba(255,255,255,0.1);
                color: white;
                width: 48px;
                height: 48px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                text-decoration: none;
                backdrop-filter: blur(10px);
                transition: all 0.2s;
                border: 1px solid rgba(255,255,255,0.2);
            }
            .nav-btn:hover {
                background: rgba(255,255,255,0.25);
                transform: translateY(-50%) scale(1.05);
            }
            .nav-btn.disabled {
                opacity: 0.3;
                cursor: not-allowed;
                pointer-events: none;
            }
            .nav-btn.prev {
                left: 20px;
            }
            .nav-btn.next {
                right: 20px;
            }
            
            /* 胶片条 */
            .filmstrip-wrapper {
                position: relative;
                flex-shrink: 0;
                background: linear-gradient(to top, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0.7) 100%);
                border-top: 1px solid rgba(255,255,255,0.08);
                backdrop-filter: blur(20px);
                -webkit-backdrop-filter: blur(20px);
            }
            /* 顶部渐变发光效果 */
            .filmstrip-wrapper::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            }
            .filmstrip {
                height: 96px;
                padding: 14px 16px;
                overflow-x: auto;
                overflow-y: hidden;
                display: flex;
                gap: 12px;
                align-items: center;
                scroll-behavior: smooth;
                /* 隐藏滚动条 */
                scrollbar-width: none;
                -ms-overflow-style: none;
                /* iOS 平滑滚动 */
                -webkit-overflow-scrolling: touch;
            }
            .filmstrip::-webkit-scrollbar {
                display: none;
            }
            .filmstrip-item {
                flex-shrink: 0;
                height: 64px;
                width: 64px;
                border-radius: 8px;
                overflow: hidden;
                cursor: pointer;
                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                border: 2px solid rgba(255,255,255,0.15);
                opacity: 0.5;
                filter: grayscale(40%);
                position: relative;
            }
            .filmstrip-item:hover {
                opacity: 0.85;
                filter: grayscale(0%);
                border-color: rgba(255,255,255,0.4);
                transform: scale(1.08);
            }
            .filmstrip-item.active {
                border-color: white;
                opacity: 1;
                filter: grayscale(0%);
                transform: scale(1.12);
                box-shadow: 0 0 20px rgba(255,255,255,0.15), 0 4px 12px rgba(0,0,0,0.3);
            }
            .filmstrip-item img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }
            /* 虚拟滚动占位符 */
            .filmstrip-placeholder {
                flex-shrink: 0;
                height: 64px;
            }
            
            @media (max-width: 768px) {
                .photo-container {
                    flex-direction: column;
                    overflow-y: auto;
                }
                .photo-main-wrapper {
                    height: auto;
                    min-height: 60vh;
                    flex: none;
                }
                .photo-main {
                    min-height: 50vh;
                }
                .photo-sidebar {
                    width: 100%;
                    height: auto;
                    overflow: visible;
                }
                .nav-btn {
                    width: 40px;
                    height: 40px;
                }
                .nav-btn.prev {
                    left: 10px;
                }
                .nav-btn.next {
                    right: 10px;
                }
                .filmstrip-wrapper {
                    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.8) 100%);
                }
                .filmstrip {
                    height: 76px;
                    padding: 10px 12px;
                    gap: 8px;
                }
                .filmstrip-item {
                    height: 48px;
                    width: 48px;
                    border-radius: 6px;
                }
                .filmstrip-item.active {
                    transform: scale(1.1);
                }
            }
        </style>
	</head>
	<body>
		<main class="photo-container">
            <div class="photo-main-wrapper">
                <!-- 顶部工具栏 -->
                <div class="toolbar">
                    <div class="toolbar-left">
                        <a href="/" class="toolbar-btn" aria-label="返回画廊">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                        </a>
                        <span class="zoom-indicator" id="zoomIndicator">100%</span>
                    </div>
                    <div class="toolbar-right">
                        <button class="toolbar-btn" id="zoomOutBtn" aria-label="缩小">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                        </button>
                        <button class="toolbar-btn" id="zoomInBtn" aria-label="放大">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line><line x1="11" y1="8" x2="11" y2="14"></line><line x1="8" y1="11" x2="14" y2="11"></line></svg>
                        </button>
                        <button class="toolbar-btn" id="resetZoomBtn" aria-label="重置">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 21l-6-6m6 6v-4.8m0 4.8h-4.8"></path><path d="M3 16.2V21m0 0h4.8M3 21l6-6"></path><path d="M21 7.8V3m0 0h-4.8M21 3l-6 6"></path><path d="M3 7.8V3m0 0h4.8M3 3l6 6"></path></svg>
                        </button>
                    </div>
                </div>

                <!-- 图片主区域 -->
                <div class="photo-main">
                    <!-- 上一张按钮 -->
                    {prevPhoto ? (
                        <a href={`/Gallery/${prevPhoto.key}`} class="nav-btn prev" aria-label="上一张">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </a>
                    ) : (
                        <span class="nav-btn prev disabled">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
                        </span>
                    )}
                    
                    <div class="image-container" id="imageContainer">
                        <img 
                            id="mainImage"
                            src={Original?.url || thumbnails.large?.url || thumbnails.medium.url} 
                            alt={filename} 
                            draggable="false"
                        />
                    </div>
                    
                    <!-- 下一张按钮 -->
                    {nextPhoto ? (
                        <a href={`/Gallery/${nextPhoto.key}`} class="nav-btn next" aria-label="下一张">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </a>
                    ) : (
                        <span class="nav-btn next disabled">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                        </span>
                    )}
                </div>
                
                <!-- 胶片条 -->
                <div class="filmstrip-wrapper">
                    <div class="filmstrip" id="filmstrip">
                        {allPhotos.map((p, index) => (
                            <a 
                                href={`/Gallery/${p.key}`} 
                                class={`filmstrip-item ${index === currentIndex ? 'active' : ''}`}
                                data-index={index}
                            >
                                <img 
                                    src={p.thumbnails?.small?.url || p.thumbnails?.medium?.url} 
                                    alt={p.filename}
                                    loading="lazy"
                                />
                            </a>
                        ))}
                    </div>
                </div>
            </div>
            
            <aside class="photo-sidebar">
                <div class="info-section">
                    <h3>基本信息</h3>
                    <div class="info-grid">
                        <div class="info-item" style="grid-column: span 2;">
                            <span class="info-label">文件名</span>
                            <span class="info-value">{filename}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">格式</span>
                            <span class="info-value">{format?.toUpperCase()}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">尺寸</span>
                            <span class="info-value">{width} x {height}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">文件大小</span>
                            <span class="info-value">{formatBytes(size)}</span>
                        </div>
                        <div class="info-item" style="grid-column: span 2;">
                            <span class="info-label">拍摄时间</span>
                            <span class="info-value">{exif?.DateTimeOriginal ? formatDate(exif.DateTimeOriginal) : formatDate(lastModified)}</span>
                        </div>
                    </div>
                </div>

                {exif && (
                    <div class="info-section">
                        <h3>拍摄参数</h3>
                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">焦距</span>
                                <span class="info-value">{exif.FocalLength ? `${exif.FocalLength}mm` : '--'}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">光圈</span>
                                <span class="info-value">{exif.FNumber ? `f/${exif.FNumber}` : '--'}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">快门</span>
                                <span class="info-value">{exif.ExposureTime ? (exif.ExposureTime < 1 ? `1/${Math.round(1/exif.ExposureTime)}` : exif.ExposureTime) + 's' : '--'}</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">ISO</span>
                                <span class="info-value">{exif.ISO || '--'}</span>
                            </div>
                        </div>
                    </div>
                )}

                {exif && (exif.Make || exif.Model || exif.LensModel) && (
                    <div class="info-section">
                        <h3>设备信息</h3>
                        <div class="info-item" style="margin-bottom: 12px;">
                            <span class="info-label">相机</span>
                            <span class="info-value">{exif.Make} {exif.Model}</span>
                        </div>
                        {exif.LensModel && (
                            <div class="info-item">
                                <span class="info-label">镜头</span>
                                <span class="info-value">{exif.LensModel}</span>
                            </div>
                        )}
                    </div>
                )}

                {tags && tags.length > 0 && (
                    <div class="info-section">
                        <h3>标签</h3>
                        <div class="tag-cloud">
                            {tags.map((tag: string) => (
                                <span class="tag">#{tag}</span>
                            ))}
                        </div>
                    </div>
                )}
            </aside>
		</main>
        
        <!-- 存储导航信息供 JS 使用 -->
        <script define:vars={{ prevPhotoKey: prevPhoto?.key || null, nextPhotoKey: nextPhoto?.key || null, currentIndex }}>
            window.__photoNav = {
                prevKey: prevPhotoKey,
                nextKey: nextPhotoKey,
                currentIndex: currentIndex
            };
        </script>
        
        <script>
            // 图片缩放和拖拽功能
            // 使用 astro:page-load 事件确保在 View Transitions 导航后重新初始化
            function initGalleryPage() {
                const container = document.getElementById('imageContainer');
                const img = document.getElementById('mainImage') as HTMLImageElement | null;
                const zoomIndicator = document.getElementById('zoomIndicator');
                const zoomInBtn = document.getElementById('zoomInBtn');
                const zoomOutBtn = document.getElementById('zoomOutBtn');
                const resetZoomBtn = document.getElementById('resetZoomBtn');
                const filmstrip = document.getElementById('filmstrip');
                
                if (!container || !img) return;
                
                // 缩放状态
                let scale = 1;
                let translateX = 0;
                let translateY = 0;
                const MIN_SCALE = 0.5;
                const MAX_SCALE = 5;
                const ZOOM_STEP = 0.25;
                
                // 拖拽状态
                let isDragging = false;
                let startX = 0;
                let startY = 0;
                let lastTranslateX = 0;
                let lastTranslateY = 0;
                
                // 触摸缩放状态
                let initialPinchDistance = 0;
                let initialScale = 1;
                
                function updateTransform() {
                    img.style.transform = `translate(${translateX}px, ${translateY}px) scale(${scale})`;
                    zoomIndicator.textContent = `${Math.round(scale * 100)}%`;
                }
                
                function resetZoom() {
                    scale = 1;
                    translateX = 0;
                    translateY = 0;
                    updateTransform();
                }
                
                function zoomIn() {
                    scale = Math.min(MAX_SCALE, scale + ZOOM_STEP);
                    updateTransform();
                }
                
                function zoomOut() {
                    scale = Math.max(MIN_SCALE, scale - ZOOM_STEP);
                    if (scale <= 1) {
                        translateX = 0;
                        translateY = 0;
                    }
                    updateTransform();
                }
                
                // 鼠标滚轮缩放
                container.addEventListener('wheel', (e) => {
                    e.preventDefault();
                    
                    const rect = container.getBoundingClientRect();
                    const mouseX = e.clientX - rect.left - rect.width / 2;
                    const mouseY = e.clientY - rect.top - rect.height / 2;
                    
                    const delta = e.deltaY > 0 ? -ZOOM_STEP : ZOOM_STEP;
                    const newScale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, scale + delta));
                    
                    if (newScale !== scale) {
                        // 缩放时保持鼠标位置不变
                        const scaleFactor = newScale / scale;
                        translateX = mouseX - (mouseX - translateX) * scaleFactor;
                        translateY = mouseY - (mouseY - translateY) * scaleFactor;
                        scale = newScale;
                        
                        if (scale <= 1) {
                            translateX = 0;
                            translateY = 0;
                        }
                        
                        updateTransform();
                    }
                }, { passive: false });
                
                // 鼠标拖拽
                container.addEventListener('mousedown', (e) => {
                    if (scale > 1) {
                        isDragging = true;
                        container.classList.add('dragging');
                        startX = e.clientX;
                        startY = e.clientY;
                        lastTranslateX = translateX;
                        lastTranslateY = translateY;
                        e.preventDefault();
                    }
                });
                
                document.addEventListener('mousemove', (e) => {
                    if (!isDragging) return;
                    
                    translateX = lastTranslateX + (e.clientX - startX);
                    translateY = lastTranslateY + (e.clientY - startY);
                    updateTransform();
                });
                
                document.addEventListener('mouseup', () => {
                    isDragging = false;
                    container.classList.remove('dragging');
                });
                
                // 触摸事件处理
                function getTouchDistance(touches) {
                    const dx = touches[0].clientX - touches[1].clientX;
                    const dy = touches[0].clientY - touches[1].clientY;
                    return Math.sqrt(dx * dx + dy * dy);
                }
                
                function getTouchCenter(touches) {
                    return {
                        x: (touches[0].clientX + touches[1].clientX) / 2,
                        y: (touches[0].clientY + touches[1].clientY) / 2
                    };
                }
                
                container.addEventListener('touchstart', (e) => {
                    if (e.touches.length === 2) {
                        // 双指缩放开始
                        e.preventDefault();
                        initialPinchDistance = getTouchDistance(e.touches);
                        initialScale = scale;
                    } else if (e.touches.length === 1 && scale > 1) {
                        // 单指拖拽开始
                        isDragging = true;
                        startX = e.touches[0].clientX;
                        startY = e.touches[0].clientY;
                        lastTranslateX = translateX;
                        lastTranslateY = translateY;
                    }
                }, { passive: false });
                
                container.addEventListener('touchmove', (e) => {
                    if (e.touches.length === 2) {
                        // 双指缩放
                        e.preventDefault();
                        const currentDistance = getTouchDistance(e.touches);
                        const scaleChange = currentDistance / initialPinchDistance;
                        const newScale = Math.max(MIN_SCALE, Math.min(MAX_SCALE, initialScale * scaleChange));
                        
                        const rect = container.getBoundingClientRect();
                        const center = getTouchCenter(e.touches);
                        const centerX = center.x - rect.left - rect.width / 2;
                        const centerY = center.y - rect.top - rect.height / 2;
                        
                        const scaleFactor = newScale / scale;
                        translateX = centerX - (centerX - translateX) * scaleFactor;
                        translateY = centerY - (centerY - translateY) * scaleFactor;
                        scale = newScale;
                        
                        if (scale <= 1) {
                            translateX = 0;
                            translateY = 0;
                        }
                        
                        updateTransform();
                    } else if (e.touches.length === 1 && isDragging) {
                        // 单指拖拽
                        e.preventDefault();
                        translateX = lastTranslateX + (e.touches[0].clientX - startX);
                        translateY = lastTranslateY + (e.touches[0].clientY - startY);
                        updateTransform();
                    }
                }, { passive: false });
                
                container.addEventListener('touchend', () => {
                    isDragging = false;
                    initialPinchDistance = 0;
                });
                
                // 双击重置
                let lastTap = 0;
                container.addEventListener('touchend', (e) => {
                    const currentTime = new Date().getTime();
                    const tapLength = currentTime - lastTap;
                    if (tapLength < 300 && tapLength > 0) {
                        e.preventDefault();
                        if (scale === 1) {
                            scale = 2;
                        } else {
                            scale = 1;
                            translateX = 0;
                            translateY = 0;
                        }
                        updateTransform();
                    }
                    lastTap = currentTime;
                });
                
                // 按钮事件
                zoomInBtn?.addEventListener('click', zoomIn);
                zoomOutBtn?.addEventListener('click', zoomOut);
                resetZoomBtn?.addEventListener('click', resetZoom);
                
                // 滚动胶片条到当前项（居中显示）
                const activeItem = filmstrip?.querySelector('.filmstrip-item.active') as HTMLElement | null;
                if (activeItem && filmstrip) {
                    // 计算需要滚动的位置，使当前项居中
                    const scrollToCenter = () => {
                        const containerWidth = filmstrip.offsetWidth;
                        const itemWidth = activeItem.offsetWidth;
                        const itemLeft = activeItem.offsetLeft;
                        const scrollLeft = itemLeft - containerWidth / 2 + itemWidth / 2;
                        return scrollLeft;
                    };
                    
                    // 页面加载时立即定位（无动画），避免从头滚动的视觉问题
                    filmstrip.style.scrollBehavior = 'auto';
                    filmstrip.scrollLeft = scrollToCenter();
                    
                    // 恢复平滑滚动，供后续交互使用
                    requestAnimationFrame(() => {
                        filmstrip.style.scrollBehavior = 'smooth';
                    });
                }
                
                // 胶片条鼠标滚轮横向滚动
                if (filmstrip) {
                    filmstrip.addEventListener('wheel', (e) => {
                        e.preventDefault();
                        
                        // 优先使用触控板的横向滚动 (deltaX)
                        // 如果没有横向滚动，则将垂直滚动 (deltaY) 转换为横向滚动
                        const scrollAmount = Math.abs(e.deltaX) > Math.abs(e.deltaY) 
                            ? e.deltaX 
                            : e.deltaY;
                        
                        filmstrip.scrollLeft += scrollAmount;
                    }, { passive: false });
                }
                
                // 存储当前页面的缩放函数供键盘事件使用
                (window as any).__currentZoomFns = { zoomIn, zoomOut, resetZoom };
            }
            
            // 键盘快捷键处理（只绑定一次，避免重复）
            let keyboardHandlerBound = false;
            function setupKeyboardHandler() {
                if (keyboardHandlerBound) return;
                keyboardHandlerBound = true;
                
                document.addEventListener('keydown', (e) => {
                    const nav = (window as any).__photoNav;
                    const zoomFns = (window as any).__currentZoomFns;
                    
                    // 只在详情页处理键盘事件
                    if (!nav) return;
                    
                    switch (e.key) {
                        case 'ArrowLeft':
                            if (nav?.prevKey) {
                                // 使用 Astro 的 navigate API 或直接链接跳转
                                const link = document.querySelector(`a[href="/Gallery/${nav.prevKey}"]`) as HTMLAnchorElement;
                                if (link) link.click();
                            }
                            break;
                        case 'ArrowRight':
                            if (nav?.nextKey) {
                                const link = document.querySelector(`a[href="/Gallery/${nav.nextKey}"]`) as HTMLAnchorElement;
                                if (link) link.click();
                            }
                            break;
                        case '+':
                        case '=':
                            e.preventDefault();
                            zoomFns?.zoomIn?.();
                            break;
                        case '-':
                        case '_':
                            e.preventDefault();
                            zoomFns?.zoomOut?.();
                            break;
                        case '0':
                            e.preventDefault();
                            zoomFns?.resetZoom?.();
                            break;
                        case 'Escape':
                            const backLink = document.querySelector('a[href="/"]') as HTMLAnchorElement;
                            if (backLink) backLink.click();
                            break;
                    }
                });
            }
            
            // 初始加载时执行
            initGalleryPage();
            setupKeyboardHandler();
        </script>
	</body>
</html>
