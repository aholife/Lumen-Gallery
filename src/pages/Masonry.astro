---
import Layout from '../layouts/GalleryPost.astro';
import BlurHashImage from '../components/BlurHashImage.astro';
import '../styles/global.css';
import { readFile } from 'fs/promises';
import { join } from 'path';

export const title = '照片画廊';
export const description = '欢迎来到我的照片画廊';
export const pubDate = new Date();

// 读取处理后的照片元数据
let photos: any[] = [];
let hasPhotos = false;

try {
  // 在 Astro 中，构建时可以直接使用 Node.js API
  const photosPath = join(process.cwd(), 'public', 'photos.json');
  const data = await readFile(photosPath, 'utf-8');
  photos = JSON.parse(data);
  hasPhotos = photos.length > 0;
  console.log(`✅ Loaded ${photos.length} photos`);
} catch (error) {
  console.log('⚠️  Photos not processed yet. Run: pnpm process-images');
}
---

<Layout title={title} description={description} pubDate={pubDate}>
  <article class="gallery-page">

    {!hasPhotos ? (
      <div class="welcome-section">
        <div class="info-card">
          <h2>🎉 欢迎使用 Lumen Gallery！</h2>
          <p>看起来你还没有添加照片。让我们开始吧！</p>

          <div class="steps">
            <div class="step">
              <div class="step-number">1</div>
              <div class="step-content">
                <h3>添加照片</h3>
                <p>将你的照片放入 <code>public/photos/</code> 目录</p>
                <p class="hint">支持 JPG, PNG, HEIC, TIFF 等格式</p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>
              <div class="step-content">
                <h3>处理图片</h3>
                <p>在终端运行：</p>
                <pre><code>pnpm process-images</code></pre>
                <p class="hint">会自动生成缩略图和提取 EXIF 信息</p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>
              <div class="step-content">
                <h3>查看效果</h3>
                <p>刷新此页面，你的照片画廊就会出现！</p>
              </div>
            </div>
          </div>

          <div class="resources">
            <h3>📚 学习资源</h3>
            <ul>
              <li>
                <a href="/快速开始.md" target="_blank">快速开始指南</a> - 详细的上手教程
              </li>
              <li>
                <a href="/Astro学习笔记.md" target="_blank">Astro 学习笔记</a> - 从 Vue3 过渡到 Astro
              </li>
              <li>
                <a href="/开发计划.md" target="_blank">开发计划</a> - 完整的功能规划
              </li>
            </ul>
          </div>
        </div>
      </div>
    ) : (
      <div class="gallery-container">

        <div class="photo-grid">
          {photos.map((photo, index) => (
            <div class="photo-card" data-index={index}>
              <div class="photo-content">
                <div class="photo-wrapper">
                  <BlurHashImage
                    src={photo.thumbnails.medium.url}
                    alt={photo.filename}
                    width={photo.thumbnails.medium.width}
                    height={photo.thumbnails.medium.height}
                    blurhash={photo.blurhash}
                    loading="eager"
                  />
                </div>
                
                {/* <div class="photo-info">
                  <h3 class="photo-title">{photo.filename}</h3>
                  
                  {photo.exif.dateTime && (
                    <p class="photo-date">
                      📅 {new Date(photo.exif.dateTime).toLocaleDateString('zh-CN')}
                    </p>
                  )}
                  
                  {(photo.exif.make || photo.exif.model) && (
                    <p class="photo-camera">
                      📷 {photo.exif.make} {photo.exif.model}
                    </p>
                  )}
                  
                  {photo.tags.length > 0 && (
                    <div class="photo-tags">
                      {photo.tags.map((tag: string) => (
                        <span class="tag">#{tag}</span>
                      ))}
                    </div>
                  )}
                </div> */}
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </article>
</Layout>

<style>


  /* 欢迎页面样式 */
  .welcome-section {
    display: flex;
    justify-content: center;
    padding: 2rem;
  }

  .info-card {
    max-width: 800px;
    background: white;
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .info-card h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: #2563eb;
  }

  .steps {
    margin: 2rem 0;
  }

  .step {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: #f8fafc;
    border-radius: 8px;
  }

  .step-number {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: #2563eb;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.25rem;
  }

  .step-content h3 {
    margin: 0 0 0.5rem 0;
    color: #1e293b;
  }

  .step-content p {
    margin: 0.5rem 0;
    color: #64748b;
  }

  .step-content code,
  .step-content pre {
    background: #1e293b;
    color: #f1f5f9;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    display: inline-block;
  }

  .hint {
    font-size: 0.875rem;
    font-style: italic;
  }

  .resources {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 2px solid #e2e8f0;
  }

  .resources ul {
    list-style: none;
    padding: 0;
  }

  .resources li {
    margin: 0.75rem 0;
  }

  .resources a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 500;
  }

  .resources a:hover {
    text-decoration: underline;
  }

  /* 画廊样式 */
  .gallery-stats {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 1.125rem;
    color: #64748b;
  }

  /* 🎯 Masonry.js 瀑布流布局 */
  .photo-grid {
    width: auto;
    margin: 0 -10px; /* 抵消 padding */
  }

  /* 📱 响应式断点：根据屏幕宽度调整列数 */
  .photo-card {
    width: 50%; /* 2列 */
    padding: 0 10px;
    margin-bottom: 20px;
  }

  .photo-content {
    background: white;
    border-radius: 8px;
    
    /* 视觉效果 */
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    
    /* 平滑过渡效果 */
    transition: transform 0.2s, box-shadow 0.2s;
  }

  @media (min-width: 640px) {
    .photo-card {
      width: 25%; /* 4列 */
    }
  }

  @media (min-width: 1024px) {
    .photo-card {
      width: 16.666%; /* 6列 */
    }
  }

  @media (min-width: 1536px) {
    .photo-card {
      width: 12.5%; /* 8列 */
    }
  }

  .photo-content:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    cursor: pointer;
  
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    cursor: pointer;
  }

  .photo-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .photo-info {
    padding: 1.5rem;
  }

  .photo-title {
    margin: 0 0 0.75rem 0;
    font-size: 1.125rem;
    color: #1e293b;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .photo-date,
  .photo-camera {
    margin: 0.5rem 0;
    font-size: 0.875rem;
    color: #64748b;
  }

  .photo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: #e0e7ff;
    color: #3730a3;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .info-card {
      padding: 2rem;
    }

    .step {
      flex-direction: column;
      gap: 1rem;
    }
  }

  /* 图片加载动画 */
  .photo-wrapper img {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .photo-wrapper img.loaded {
    opacity: 1;
  }
</style>

<script>
  import Masonry from 'masonry-layout';
  import imagesLoaded from 'imagesloaded';

  /**
   * 🎨 智能图片懒加载 + 淡入动画 + Masonry 布局
   */
  
  document.addEventListener('DOMContentLoaded', () => {
    // 1. 初始化 Masonry
    const grid = document.querySelector('.photo-grid');
    if (grid) {
      const msnry = new Masonry(grid, {
        itemSelector: '.photo-card',
        percentPosition: true
      });

      // 确保图片加载后重新布局
      imagesLoaded(grid).on('progress', function() {
        msnry.layout();
      });
    }

    // 2. 图片懒加载逻辑
    const images = document.querySelectorAll<HTMLImageElement>('.photo-wrapper img');
    
    // 检查浏览器是否支持 Intersection Observer
    if ('IntersectionObserver' in window) {
      
      /**
       * 创建 Intersection Observer
       * 
       * @param rootMargin - 提前加载的距离
       *   - '200px' 表示图片距离视口还有 200px 时就开始加载
       *   - 这样用户滚动到时图片已经加载完成，体验更流畅
       * 
       * @param threshold - 触发回调的可见比例
       *   - 0.01 表示元素只要有 1% 可见就触发
       */
      const imageObserver = new IntersectionObserver((entries, observer) => {
        entries.forEach(entry => {
          // 当图片进入可视区域（或接近可视区域）
          if (entry.isIntersecting) {
            const img = entry.target as HTMLImageElement;
            
            // 如果图片已经加载完成（来自缓存）
            if (img.complete) {
              img.classList.add('loaded');
            } else {
              // 监听首次加载完成
              img.addEventListener('load', () => {
                img.classList.add('loaded');
              }, { once: true }); // once: true 表示只触发一次
              
              // 监听加载失败
              img.addEventListener('error', () => {
                console.error('图片加载失败:', img.src);
                img.classList.add('loaded'); // 即使失败也显示（会显示 Blurhash 占位符）
              }, { once: true });
            }
            
            // 停止观察这张图片（已经处理过了）
            observer.unobserve(img);
          }
        });
      }, {
        // 提前 200px 开始加载，用户滚动时图片已经准备好
        rootMargin: '200px 0px',
        // 元素只要有 1% 可见就触发
        threshold: 0.01
      });
      
      // 开始观察所有图片
      images.forEach(img => {
        imageObserver.observe(img);
      });
      
    } else {
      // 降级方案：不支持 Intersection Observer 的旧浏览器
      // 直接加载所有图片（保证功能可用）
      console.warn('浏览器不支持 Intersection Observer，使用降级方案');
      
      images.forEach((img) => {
        if (img.complete) {
          img.classList.add('loaded');
        } else {
          img.addEventListener('load', () => {
            img.classList.add('loaded');
          });
          
          img.addEventListener('error', () => {
            console.error('图片加载失败:', img.src);
            img.classList.add('loaded');
          });
        }
      });
    }
  });
</script>
