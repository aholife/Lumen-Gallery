---
import Layout from '../layouts/GalleryPost.astro';
import MasonicGallery from '../components/MasonicGallery';
import '../styles/global.css';
import { readFile } from 'fs/promises';
import { join } from 'path';

export const title = '照片画廊 (Masonic)';
export const description = '欢迎来到我的照片画廊';
export const pubDate = new Date();

// 读取处理后的照片元数据
let photos: any[] = [];
let hasPhotos = false;

try {
  // 在 Astro 中，构建时可以直接使用 Node.js API
  const photosPath = join(process.cwd(), 'public', 'photos.json');
  const data = await readFile(photosPath, 'utf-8');
  photos = JSON.parse(data);
  hasPhotos = photos.length > 0;
  console.log(`✅ Loaded ${photos.length} photos`);
} catch (error) {
  console.log('⚠️  Photos not processed yet. Run: pnpm process-images');
}

function formatBytes(bytes: number, decimals = 1) {
  if (!+bytes) return '0 Bytes';
  const k = 1024;
  const dm = decimals < 0 ? 0 : decimals;
  const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(dm))}${sizes[i]}`;
}
---

<Layout title={title} description={description} pubDate={pubDate}>
  <article class="gallery-page">

    {!hasPhotos ? (
      <div class="welcome-section">
        <div class="info-card">
          <h2>🎉 欢迎使用 Lumen Gallery！</h2>
          <p>看起来你还没有添加照片。让我们开始吧！</p>

          <div class="steps">
            <div class="step">
              <div class="step-number">1</div>
              <div class="step-content">
                <h3>添加照片</h3>
                <p>将你的照片放入 <code>public/photos/</code> 目录</p>
                <p class="hint">支持 JPG, PNG, HEIC, TIFF 等格式</p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">2</div>
              <div class="step-content">
                <h3>处理图片</h3>
                <p>在终端运行：</p>
                <pre><code>pnpm process-images</code></pre>
                <p class="hint">会自动生成缩略图和提取 EXIF 信息</p>
              </div>
            </div>

            <div class="step">
              <div class="step-number">3</div>
              <div class="step-content">
                <h3>查看效果</h3>
                <p>刷新此页面，你的照片画廊就会出现！</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    ) : (
      <div class="gallery-container">
        <MasonicGallery client:only="react" photos={photos} columnWidth={240} />
      </div>
    )}
  </article>
</Layout>

<style>
  /* 欢迎页面样式 */
  .welcome-section {
    display: flex;
    justify-content: center;
    padding: 2rem;
  }

  .info-card {
    max-width: 800px;
    background: white;
    border-radius: 12px;
    padding: 3rem;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .info-card h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    color: #2563eb;
  }

  .steps {
    margin: 2rem 0;
  }

  .step {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: #f8fafc;
    border-radius: 8px;
  }

  .step-number {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: #2563eb;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 1.25rem;
  }

  .step-content h3 {
    margin: 0 0 0.5rem 0;
    color: #1e293b;
  }

  .step-content p {
    margin: 0.5rem 0;
    color: #64748b;
  }

  .step-content code,
  .step-content pre {
    background: #1e293b;
    color: #f1f5f9;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    font-family: 'Courier New', monospace;
    display: inline-block;
  }

  .hint {
    font-size: 0.875rem;
    font-style: italic;
  }

  /* 画廊样式 */
  .gallery-stats {
    text-align: center;
    margin-bottom: 2rem;
    font-size: 1.125rem;
    color: #64748b;
  }

  /* 🎯 Masonry.js 瀑布流布局 */
  .photo-grid {
    width: auto;
    margin: 0 -10px; /* 抵消 padding */
  }

  /* 📱 响应式断点：根据屏幕宽度调整列数 */
  .photo-card {
    width: 50%; /* 2列 */
    padding: 0 5px;
    margin-bottom: 10px;
  }

  .photo-content {
    position: relative;
    background: white;
    
    /* 视觉效果 */
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    
    /* 平滑过渡效果 */
    transition: transform 0.2s, box-shadow 0.2s;
  }

  @media (min-width: 640px) {
    .photo-card {
      width: 25%; /* 4列 */
    }
  }

  @media (min-width: 1024px) {
    .photo-card {
      width: 16.666%; /* 6列 */
    }
  }

  @media (min-width: 1536px) {
    .photo-card {
      width: 12.5%; /* 8列 */
    }
  }

  .photo-content:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    cursor: pointer;
  
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.15);
    cursor: pointer;
  }

  .photo-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .photo-info {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    padding: 1rem;
    background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 70%, transparent 100%);
    color: white;
    opacity: 0;
    transition: opacity 0.3s ease;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    pointer-events: none;
  }

  .photo-content:hover .photo-info {
    opacity: 1;
  }

  .info-row {
    display: flex;
    align-items: center;
  }

  .tags {
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border-radius: 4px;
    font-size: 0.75rem;
    backdrop-filter: blur(4px);
  }

  .details {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.9);
    gap: 0.5rem;
    font-family: monospace; /* Optional: makes numbers align better */
  }

  .separator {
    opacity: 0.6;
  }

  @media (max-width: 768px) {
    .info-card {
      padding: 2rem;
    }

    .step {
      flex-direction: column;
      gap: 1rem;
    }
  }

  /* 图片加载动画 */
  .photo-wrapper img {
    opacity: 0;
    transition: opacity 0.3s ease-in-out;
  }

  .photo-wrapper img.loaded {
    opacity: 1;
  }
</style>
